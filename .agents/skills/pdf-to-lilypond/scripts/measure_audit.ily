% Loaded by validate_score.py. LilyPond, rather than a textual note parser,
% supplies exact rational durations after resolving variables, tuplets and tags.
\version "2.26.0"
#(define (audit-children music)
   (append
    (filter ly:music? (ly:music-property music 'elements '()))
    (let ((one (ly:music-property music 'element #f)))
      (if (ly:music? one) (list one) '()))))

#(define (audit-voice-node? music)
   (and (eq? (ly:music-property music 'name) 'ContextSpeccedMusic)
        (eq? (ly:music-property music 'context-type) 'Voice)
        ;; \voiceOne and context-scoped settings expand to unnamed, zero-time
        ;; ContextSpeccedMusic too; these are controls, not independent voices.
        (or (not (equal? (ly:music-property music 'context-id "") ""))
            (not (= (ly:moment-main (ly:music-length music)) 0))
            (audit-has-notes? music))))

#(define (audit-voice-nodes music)
   (append (if (audit-voice-node? music) (list music) '())
           (apply append (map audit-voice-nodes (audit-children music)))))

#(define (audit-main-notes? music)
   (and (not (eq? (ly:music-property music 'name) 'GraceMusic))
        (or (audit-note-or-rest? music)
            (any audit-main-notes? (audit-children music)))))

#(define (audit-has-grace? music)
   (or (eq? (ly:music-property music 'name) 'GraceMusic)
       (any audit-has-grace? (audit-children music))))

#(define (audit-after-grace-wrapper? music)
   ;; afterGrace expands to Bottom << main { skip grace } >>. Exempt just
   ;; that compiler shape, not arbitrary anonymous annotation counterpoint.
   (and (eq? (ly:music-property music 'name) 'ContextSpeccedMusic)
        (eq? (ly:music-property music 'context-type) 'Bottom)
        (let* ((body (ly:music-property music 'element #f))
               (branches (if (ly:music? body) (audit-children body) '())))
          (and (ly:music? body)
               (eq? (ly:music-property body 'name) 'SimultaneousMusic)
               (= (length branches) 2)
               (= (length (filter audit-has-grace? branches)) 1)
               (= (length (filter audit-main-notes? branches)) 1)
               (every (lambda (branch)
                        (or (not (audit-has-grace? branch))
                            (not (audit-main-notes? branch)))) branches)))))

#(define (audit-hidden-polyphony? music)
   (if (audit-after-grace-wrapper? music)
       (any audit-hidden-polyphony?
            (audit-children (ly:music-property music 'element)))
       (or (and (eq? (ly:music-property music 'name) 'SimultaneousMusic)
                (> (length (filter
                            (lambda (branch) (> (ly:moment-main (ly:music-length branch)) 0))
                            (audit-children music))) 1))
           (any audit-hidden-polyphony? (audit-children music)))))

#(define (audit-note-or-rest? music)
   (memq (ly:music-property music 'name)
         '(NoteEvent RestEvent MultiMeasureRestMusic MultiMeasureRestEvent)))

#(define (audit-has-notes? music)
   (or (audit-note-or-rest? music)
       (any audit-has-notes? (audit-children music))))

#(define (audit-unvoiced? music)
   (if (and (eq? (ly:music-property music 'name) 'ContextSpeccedMusic)
            (eq? (ly:music-property music 'context-type) 'Voice))
       #f
       (or (audit-note-or-rest? music)
           (memq (ly:music-property music 'name) '(SkipEvent SkipMusic))
           (any audit-unvoiced? (audit-children music)))))

#(define (audit-emit text)
   (display (string-append "PDF2LY\t" text "\n")))

#(define (audit-measure label music expected-n expected-d required annotations tag)
   (let* ((selected (music-filter (tags-keep-predicate tag)
                                 (ly:music-deep-copy music)))
          (expected (/ expected-n expected-d))
          (voices (audit-voice-nodes selected))
          (seen '())
          (bad #f))
     (if (audit-unvoiced? selected)
         (begin (set! bad #t)
                (audit-emit (format #f "ERROR\t~a\t~a\tnotes/rests/skips outside an explicit Voice" label tag))))
     (if (null? voices)
         (begin (set! bad #t)
                (audit-emit (format #f "ERROR\t~a\t~a\tno explicit Voice contexts" label tag))))
     (for-each
      (lambda (node)
        (let* ((id (ly:music-property node 'context-id ""))
               (body (ly:music-property node 'element))
               (actual (ly:moment-main (ly:music-length body))))
          (if (or (not (string? id)) (string-null? id))
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tunnamed Voice" label tag))))
          (if (member id seen)
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tduplicate Voice ~a; combine its fragments before auditing" label tag id))))
          (set! seen (cons id seen))
          (if (not (null? (audit-voice-nodes body)))
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tnested Voice inside ~a; use sibling contexts" label tag id))))
          (if (audit-hidden-polyphony? body)
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tanonymous simultaneous duration branches in ~a" label tag id))))
          (if (and (member id annotations) (audit-has-notes? body))
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tannotation Voice ~a contains notes/rests" label tag id))))
          (if (not (member id required))
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tundeclared Voice ~a" label tag id))))
          (audit-emit (format #f "VOICE\t~a\t~a\t~a\t~a\t~a" label tag id actual expected))
          (if (not (= actual expected))
              (begin (set! bad #t)
                     (audit-emit (format #f "ERROR\t~a\t~a\tVoice ~a length ~a; expected ~a" label tag id actual expected))))))
      voices)
     (for-each
      (lambda (id)
        (if (not (member id seen))
            (begin (set! bad #t)
                   (audit-emit (format #f "ERROR\t~a\t~a\tmissing Voice ~a" label tag id)))))
      required)
     (let ((actual (ly:moment-main (ly:music-length selected))))
       (if (not (= actual expected))
           (begin (set! bad #t)
                  (audit-emit (format #f "ERROR\t~a\t~a\tmeasure length ~a; expected ~a" label tag actual expected)))))
     (audit-emit (format #f "MEASURE\t~a\t~a\t~a" label tag (if bad "FAIL" "PASS")))))
