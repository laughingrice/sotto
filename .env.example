# Public Microsoft application ID (not a client secret).
# Register the SPA callback shown in Library > OneDrive app setup.
VITE_ONEDRIVE_CLIENT_ID=

# Public Dropbox App key (not an App secret or generated token).
# Register the redirect URI shown in Library > Dropbox app setup.
VITE_DROPBOX_APP_KEY=
# Set app_folder only for a Dropbox app registered with App Folder access.
# Full Dropbox keys use /Apps/Sotto/practice-settings-v1.json for optional sync.
VITE_DROPBOX_ACCESS_TYPE=
