% Parsed-music tab adapter. Loaded after practice-map.ily and generated config.
#(define sotto-visual-port (open-output-file "visuals.jsonl"))
#(define sotto-systems (make-hash-table))
#(define sotto-system-counter 0)
#(define sotto-original-scores '())
#(define (sotto-system-id grob)
   (let* ((system (ly:grob-system grob)) (known (hashq-ref sotto-systems system)))
     (or known (let ((id (number->string sotto-system-counter)))
       (set! sotto-system-counter (+ sotto-system-counter 1))
       (hashq-set! sotto-systems system id) id))))
#(define sotto-staff-engraver
   (lambda (context)
     (make-engraver
       (acknowledgers
         ((staff-symbol-interface engraver grob source)
           (ly:grob-set-property! grob 'after-line-breaking
             (lambda (piece) (ly:grob-set-property! piece 'output-attributes
               `((class . "sotto-staff-geometry") (data-system . ,(sotto-system-id piece)))))))
         ((bar-line-interface engraver grob source)
           (let ((beat (practice-beats (ly:context-current-moment context))))
             (ly:grob-set-property! grob 'after-line-breaking
               (lambda (piece) (ly:grob-set-property! piece 'output-attributes
                 `((class . "sotto-bar-boundary") (data-boundary-beat . ,(number->string beat))
                   (data-system . ,(sotto-system-id piece))))))))))))
#(define (sotto-staff context)
   (or (ly:context-find context 'Staff) (ly:context-find context 'TabStaff) (ly:context-find context 'DrumStaff)))
#(define (sotto-id context event)
   (let* ((tag (find (lambda (tag) (string-prefix? "sotto-event-" (symbol->string tag))) (ly:event-property event 'tags)))
          (moment (ly:context-current-moment context)))
     (if (not tag) (ly:error "Sotto could not identify a source note."))
     (format #f "~a-~a-~a-~a-~a" tag (ly:moment-main-numerator moment) (ly:moment-main-denominator moment)
       (ly:moment-grace-numerator moment) (ly:moment-grace-denominator moment))))
#(define (sotto-midi-pitch midi)
   (let* ((n (- midi 60)) (pc (modulo n 12)))
     (ly:make-pitch (inexact->exact (floor (/ n 12)))
       (vector-ref #(0 0 1 1 2 3 3 4 4 5 5 6) pc)
       (if (memv pc '(1 3 6 8 10)) 1/2 0))))
#(define (sotto-source-string event)
   (let ((item (find (lambda (item)
       (number? (if (ly:music? item) (ly:music-property item 'string-number) (ly:event-property item 'string-number))))
       (ly:event-property event 'articulations))))
     (if item (if (ly:music? item) (ly:music-property item 'string-number) (ly:event-property item 'string-number)) 0)))
#(define (sotto-note-tie? event)
   (any (lambda (item) (if (ly:music? item) (eq? (ly:music-property item 'name) 'TieEvent)
     (memq 'tie-event (ly:event-property item 'class)))) (ly:event-property event 'articulations)))
#(define (sotto-property item key)
   (if (ly:music? item) (ly:music-property item key) (ly:event-property item key)))
#(define (sotto-guide-direction event)
   (let ((tags (append (sotto-property event 'tags)
                 (append-map (lambda (item) (sotto-property item 'tags))
                   (sotto-property event 'articulations))
                 (if (and (ly:music? event) (eq? (ly:music-property event 'name) 'EventChord))
                   (append-map (lambda (item)
                     (if (eq? (ly:music-property item 'name) 'FingeringEvent) (ly:music-property item 'tags) '()))
                     (ly:music-property event 'elements)) '()))))
     (cond ((memq 'sotto-guide-up tags) 1) ((memq 'sotto-guide-down tags) -1) (else 0))))
#(define sotto-note-engraver
   (lambda (context)
     (let ((pending '()) (tied #f))
       (make-engraver
         (listeners
           ((tie-event engraver event) (set! tied #t))
           ((note-event engraver event)
             (practice-event context event practice-written-port)
             ;; Normalize tab pitches from the canonical notation pass before
             ;; Tab_note_heads_engraver computes frets. Playback octave is not
             ;; applied twice to a transposing guitar/bass source.
             (if (ly:context-find context 'TabStaff)
               (let ((midi (assoc-ref sotto-pitches (sotto-id context event))))
                 (if (not midi) (ly:error "Tab note has no canonical sounding pitch."))
                 (ly:event-set-property! event 'pitch (sotto-midi-pitch midi)))))
           ((rest-event engraver event) (practice-event context event practice-written-port))
           ((multi-measure-rest-event engraver event) (practice-event context event practice-written-port)))
         (acknowledgers
           ((note-head-interface engraver grob source)
             (let* ((event (ly:grob-property grob 'cause)) (identity (sotto-id context event))
                    (voice (practice-voice-id context)) (staff (sotto-staff context))
                    (part (if staff (ly:context-id staff) ""))
                    (tab (eq? (grob::name grob) 'TabNoteHead))
                    ;; Explicit source touch positions are different from a
                    ;; stopped fret calculated from the sounding pitch.
                    (touch (or (assoc-ref (ly:event-property event 'tweaks) '(#t details sotto-touch-fret))
                               (assoc-ref (ly:grob-property grob 'details) 'sotto-touch-fret)))
                    (sounding-octaves (or (assoc-ref (ly:event-property event 'tweaks) '(#t details sotto-sounding-octaves))
                                          (assoc-ref (ly:grob-property grob 'details) 'sotto-sounding-octaves) 0))
                    (base (or (assoc-ref (ly:event-property event 'tweaks) '(#t details sotto-base-fret))
                              (assoc-ref (ly:grob-property grob 'details) 'sotto-base-fret)))
                    (guide (sotto-guide-direction event))
                    (drum (symbol? (ly:event-property event 'drum-type)))
                    (moment (ly:context-current-moment context))
                    (string (if tab
                      (inexact->exact (round (/ (- (+ 1 (length (ly:context-property context 'stringTunings))) (ly:grob-property grob 'staff-position)) 2)))
                      (sotto-source-string event))))
               (if (and tab (number? touch))
                 (ly:grob-set-property! grob 'text
                   ;; Native \harmonic already adds its angle brackets.
                   (if (number? base)
                     (make-concat-markup (list (number->string base) "<" (number->string touch) ">"))
                   (if (any (lambda (item)
                         (if (ly:music? item) (eq? (ly:music-property item 'name) 'HarmonicEvent)
                           (memq 'harmonic-event (ly:event-property item 'class))))
                       (ly:event-property event 'articulations))
                     (number->string touch)
                     (make-concat-markup (list "<" (number->string touch) ">"))))))
               (if (and tab (not (= guide 0)))
                 (ly:grob-set-property! grob 'text
                   (make-concat-markup (list (if (> guide 0) "/" "\\") (ly:grob-property grob 'text)))))
               (ly:grob-set-property! grob 'output-attributes
                 `((id . ,(if tab (string-append "tabs-" identity) identity)) (class . "score-note")
                   (data-event-id . ,identity) (data-voice . ,voice) (data-representation . ,(if tab "tabs" "notation"))))
               (set! pending (cons (list identity voice part (practice-beats moment)
                 (* 4.0 (/ (ly:moment-grace-numerator moment) (ly:moment-grace-denominator moment)))
                 (if tab (+ 60 (ly:pitch-semitones (ly:event-property event 'pitch))) (practice-midi-pitch context event))
                 (practice-beats (ly:duration->moment (ly:event-property event 'duration)))
                 string tab drum (if tab (markup->string (ly:grob-property grob 'text)) "")
                 (if (number? touch) touch #f) sounding-octaves (if (number? base) base #f) guide (sotto-note-tie? event)) pending)))))
         ((stop-translation-timestep engraver)
           (for-each (lambda (row)
             (let ((keys '(id voice part beat grace midi duration string tab percussion fretText touchFret soundingOctaves baseFret slideIn)))
               (display "{" sotto-visual-port)
               (for-each (lambda (key value)
                 (if (not (eq? key 'id)) (display "," sotto-visual-port))
                 (practice-json-string (symbol->string key) sotto-visual-port) (display ":" sotto-visual-port)
                 (cond ((string? value) (practice-json-string value sotto-visual-port))
                       ((boolean? value) (display (if value "true" "false") sotto-visual-port))
                       (else (display (if (and (number? value) (not (integer? value))) (exact->inexact value) value) sotto-visual-port)))) keys (take row 15))
               (format sotto-visual-port ",\"tie\":~a}\n" (if (or tied (list-ref row 15)) "true" "false")))) (reverse pending))
           (force-output sotto-visual-port) (set! pending '()) (set! tied #f))))))

#(define (sotto-children music)
   (append (filter ly:music? (ly:music-property music 'elements '()))
     (let ((one (ly:music-property music 'element #f))) (if (ly:music? one) (list one) '()))))
#(define (sotto-tag-music music)
   (let ((counter 0))
     (define (visit node)
       ;; Fingering post-events can be siblings of a NoteEvent in an
       ;; EventChord. Resolve their guide tags before interpretation separates
       ;; those events, including in the canonical notation pass.
       (let ((guide (sotto-guide-direction node)))
         (if (not (= guide 0))
           (for-each (lambda (item)
             (if (eq? (ly:music-property item 'name) 'NoteEvent)
               (ly:music-set-property! item 'tags
                 (cons (if (> guide 0) 'sotto-guide-up 'sotto-guide-down) (ly:music-property item 'tags)))))
             (if (eq? (ly:music-property node 'name) 'NoteEvent) (list node) (ly:music-property node 'elements)))))
       (if (eq? (ly:music-property node 'name) 'NoteEvent)
         (begin (ly:music-set-property! node 'tags
           (cons (string->symbol (format #f "sotto-event-~a" counter)) (ly:music-property node 'tags)))
           (set! counter (+ counter 1))))
       (for-each visit (sotto-children node)))
     (visit music) music))
#(define (sotto-tab-copy staff setting)
   (let* ((body (ly:music-deep-copy (ly:music-property staff 'element)))
          (tuning (map sotto-midi-pitch (cadr setting))))
     (set! body (music-map (lambda (node)
       (let ((name (ly:music-property node 'name)) (symbol (ly:music-property node 'symbol)))
         (cond
           ((and (memq name '(PropertySet PropertyUnset))
             (or (eq? symbol 'instrumentTransposition) (string-prefix? "clef" (symbol->string symbol))
                 (memq symbol '(middleCPosition middleCClefPosition)))) (make-music 'SequentialMusic))
           (else
             ;; Fret numbers replace LH finger digits in the tab copy. Leaving
             ;; digits here lets LilyPond's automatic fingering allocator move
             ;; explicit strings (notably a source digit 0). Notes retains them.
             (if (eq? name 'NoteEvent)
               (begin
                 (let ((guide (sotto-guide-direction node)))
                   (if (not (= guide 0))
                     (ly:music-set-property! node 'tags
                       (cons (if (> guide 0) 'sotto-guide-up 'sotto-guide-down) (ly:music-property node 'tags)))))
                 (ly:music-set-property! node 'articulations
                 (filter (lambda (item) (not (eq? (ly:music-property item 'name) 'FingeringEvent)))
                   (ly:music-property node 'articulations)))))
             (if (eq? name 'EventChord)
               (begin
                 (let ((guide (sotto-guide-direction node)))
                   (if (not (= guide 0))
                     (for-each (lambda (item)
                       (if (eq? (ly:music-property item 'name) 'NoteEvent)
                         (ly:music-set-property! item 'tags
                           (cons (if (> guide 0) 'sotto-guide-up 'sotto-guide-down) (ly:music-property item 'tags)))))
                       (ly:music-property node 'elements))))
                 (ly:music-set-property! node 'elements
                 (filter (lambda (item) (not (eq? (ly:music-property item 'name) 'FingeringEvent)))
                   (ly:music-property node 'elements)))))
             (if (eq? (ly:music-property node 'context-type) 'Staff) (ly:music-set-property! node 'context-type 'TabStaff))
             (if (eq? (ly:music-property node 'context-type) 'Voice) (ly:music-set-property! node 'context-type 'TabVoice))
             node)))) body))
     (make-music 'ContextSpeccedMusic 'context-type 'TabStaff 'context-id (ly:music-property staff 'context-id)
       'create-new #t 'property-operations (append `((assign stringTunings ,tuning))
         (filter (lambda (op) (and (eq? (car op) 'assign) (memq (cadr op) '(instrumentName shortInstrumentName))))
                 (ly:music-property staff 'property-operations)))
       'element #{ \tabFullNotation #body #})))
#(define (sotto-transform score)
   (if (any (lambda (output) (eq? (ly:output-def-lookup output 'output-def-kind #f) 'layout)) (ly:score-output-defs score))
     (let* ((music (sotto-tag-music (ly:music-deep-copy (ly:score-music score)))) (found '()))
       (define (visit node)
         (let* ((type (ly:music-property node 'context-type)) (id (ly:music-property node 'context-id ""))
                (setting (assoc-ref sotto-tab-settings id)))
           (if (eq? type 'TabStaff) (ly:error "Tab export expects canonical Staff music, not an existing TabStaff."))
           (if (and (eq? type 'Staff) setting)
             (begin
               (if (member id found) (ly:error "Tab part Staff ID is not unique: ~a" id))
               (set! found (cons id found))
               (let ((tab (if (eq? sotto-view 'notation) #f (sotto-tab-copy node setting))))
                 (case sotto-view
                   ((tabs) tab)
                   ((both) (make-music 'ContextSpeccedMusic 'context-type 'StaffGroup 'create-new #t
                     'element (make-music 'SimultaneousMusic 'elements (list node tab))))
                   (else node))))
             (begin
               (let ((one (ly:music-property node 'element #f))) (if (ly:music? one) (ly:music-set-property! node 'element (visit one))))
               (ly:music-set-property! node 'elements (map (lambda (child) (if (ly:music? child) (visit child) child)) (ly:music-property node 'elements)))
               node))))
       ;; Remove forced page breaks, retain explicit system breaks. Users can
       ;; opt out for deliberate page turns; no view-specific breaks injected.
       (if (not sotto-keep-page-breaks)
         (set! music (music-map (lambda (node)
           (cond ((memq (ly:music-property node 'name) '(PageBreakEvent PageTurnEvent))
                  (ly:music-set-property! node 'break-permission 'allow) node)
             ((ly:music-property node 'page-marker #f)
               (ly:music-set-property! node 'page-break-permission 'allow)
               (ly:music-set-property! node 'page-turn-permission 'allow) node)
             (else node))) music)))
       (set! music (visit music))
       (for-each (lambda (setting) (if (not (member (car setting) found))
         (ly:error "Named Staff not found for --tab-part: ~a" (car setting)))) sotto-tab-settings)
       (let ((rendered (ly:make-score music)) (header (ly:score-header score)))
         (if (module? header) (ly:score-set-header! rendered header))
         (for-each (lambda (output) (ly:score-add-output-def! rendered output)) (ly:score-output-defs score))
         (set! sotto-original-scores (acons rendered score sotto-original-scores))
         rendered))
     score))
#(define sotto-old-score-handler toplevel-score-handler)
#(define toplevel-score-handler (lambda (score) (sotto-old-score-handler (sotto-transform score))))
#(define sotto-old-book-handler book-score-handler)
#(define book-score-handler (lambda (book score) (sotto-old-book-handler book (sotto-transform score))))
#(define sotto-old-bookpart-handler bookpart-score-handler)
#(define bookpart-score-handler (lambda (book score) (sotto-old-bookpart-handler book (sotto-transform score))))
#(define (sotto-export-playback)
   ;; The tab/combined engraving is never the MIDI source. This also covers
   ;; scores without a separate MIDI block, and keeps drum accompaniment once.
   (for-each (lambda (pair)
     (set! practice-header-scopes (acons (cdr pair) (assq-ref practice-header-scopes (car pair)) practice-header-scopes))) sotto-original-scores)
   (set! practice-scores (map (lambda (score) (or (assq-ref sotto-original-scores score) score)) practice-scores))
   (practice-export-playback))
